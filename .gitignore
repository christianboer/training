/tmp/
.DS_Store
.env

# Community photos harvested from Strava's route tiles — other people's
# images, kept locally for route recon only. Not ours to redistribute.
/route-photos/

__pycache__/
*.pyc

# The routebook PDF and its assets: it embeds the same Strava community photos
# as route-photos/, so it is ours to print for the crew, not ours to publish.
/routebook/
/scripts/routebook/cache/

# Crew booklet output. Unlike routebook/, everything in it is CC-licensed from
# Wikimedia Commons, so this PDF may be shared — the build artefacts just don't
# belong in git.
/crewbook/
/scripts/crewbook/cache/

# Raw Overpass responses for the surface analysis. Regenerable, and large —
# route-surface/*/segments.json is the durable part and that one is committed.
/scripts/route_surface/cache/
